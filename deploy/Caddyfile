# Caddy: HTTPS tự động + chia đường dẫn cho từng service
#   /api/*, /uploads/*  -> API Go
#   /go/*, /t/*         -> tracker Rust
#   /admin/*            -> CMS Vue (file tĩnh)
#   còn lại             -> landing Nuxt
{
	email {$ACME_EMAIL}
	# Cấu hình riêng của từng VPS do install.sh tạo (Cloudflare: xác minh HTTPS qua DNS, tin dải IP Cloudflare)
	import /etc/caddy/local/*.caddy
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# IP thật của khách: {client_ip} lấy từ CF-Connecting-IP khi request đến từ Cloudflare (xem local/cloudflare.caddy),
	# ngược lại là IP kết nối trực tiếp. Không dùng X-Forwarded-For vì khách tự chèn được.
	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle /uploads/* {
		reverse_proxy api:8080
	}
	handle /go/* {
		reverse_proxy tracker:8081
	}
	handle /t/* {
		reverse_proxy tracker:8081
	}
	redir /admin /admin/
	handle /admin/* {
		root * /srv
		header /admin/assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /admin/index.html
		file_server
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
